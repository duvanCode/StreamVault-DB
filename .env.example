# ==============================================================================
# StreamVault DB - Variables de Entorno (.env)
# ==============================================================================

# Puerto y Host del servicio
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Programación de la Copia Automática (Cron)
# '0 2 * * *' = Todos los días a las 02:00 AM
BACKUP_CRON=0 2 * * *
TIMEZONE=America/Bogota

# Seguridad opcional para el panel Web (dejar vacío si no deseas clave)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambia_esta_clave_segura

# ------------------------------------------------------------------------------
# 1. Configuración por defecto de la Base de Datos (Opcional, configurable en la Web)
# ------------------------------------------------------------------------------
DEFAULT_DB_TYPE=postgres         # 'postgres' o 'mysql'
DEFAULT_DB_HOST=localhost        # o IP privada / docker container
DEFAULT_DB_PORT=5432             # 5432 para postgres, 3306 para mysql
DEFAULT_DB_NAME=mi_base_de_datos
DEFAULT_DB_USER=postgres
DEFAULT_DB_PASSWORD=mi_password_seguro
DEFAULT_DB_SSL=false

# ------------------------------------------------------------------------------
# 2. Configuración de Google Drive (Opcional, configurable en la Web)
# ------------------------------------------------------------------------------
# ID de la carpeta de Google Drive donde se guardarán los backups:
# (Ejemplo URL: drive.google.com/drive/folders/1A2b3C4d5E6f7G8h9I0jK...)
GOOGLE_DRIVE_FOLDER_ID=

# Llave de la Cuenta de Servicio (Service Account JSON) como string de una línea:
# O ruta a un archivo json local: GOOGLE_SERVICE_ACCOUNT_FILE=/ruta/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=

# Si prefieres usar OAuth 2.0 en lugar de Service Account:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 3. Base de Datos para Pruebas de Restauración en Sandbox (Opcional)
# ------------------------------------------------------------------------------
TEST_DB_ENABLED=false
TEST_DB_TYPE=postgres
TEST_DB_HOST=
TEST_DB_PORT=5432
TEST_DB_NAME=sandbox_db
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
